# Backend API runtime environment example.
# Copy to the target server as backend-api.env and fill real values there.

ENVIRONMENT=qa
SERVER_PORT=8080

# Example database settings. Adjust to match the backend application.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ids_backend
DB_USERNAME=ids_backend
DB_PASSWORD=change-me-on-server

# Security / integration placeholders.
JWT_SECRET=change-me-on-server
MISP_BASE_URL=
MISP_API_KEY=

