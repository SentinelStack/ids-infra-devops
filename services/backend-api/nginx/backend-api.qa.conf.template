server {
    listen 80;
    server_name api.qa.example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name api.qa.example.com;

    ssl_certificate /etc/letsencrypt/live/api.qa.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.qa.example.com/privkey.pem;

    access_log /var/log/nginx/backend-api.qa.access.log;
    error_log /var/log/nginx/backend-api.qa.error.log;

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

