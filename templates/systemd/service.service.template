[Unit]
Description=IDS Platform Service
After=network.target

[Service]
Type=simple
User=ids-service
Group=ids-service
WorkingDirectory=/opt/ids-platform/service/current
EnvironmentFile=/opt/ids-platform/service/shared/service.env
ExecStart=/path/to/service
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

