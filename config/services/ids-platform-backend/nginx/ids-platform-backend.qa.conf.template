server {
    listen 80;
    server_name qa-api.puk3p.online;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name qa-api.puk3p.online;

    ssl_certificate /etc/letsencrypt/live/qa-api.puk3p.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/qa-api.puk3p.online/privkey.pem;

    access_log /var/log/nginx/ids-platform-backend.qa.access.log;
    error_log /var/log/nginx/ids-platform-backend.qa.error.log;

    location / {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

