# Non-secret environment defaults for ids-platform-backend.
# Secrets (e.g. MONGODB_URI) are NOT listed here — they are rendered from Vault
# at deploy time by scripts/render-env-from-vault.sh (see ../vault.manifest.yml).

ENVIRONMENT=qa
SERVER_PORT=8082
SPRING_PROFILES_ACTIVE=qa

MONGODB_DATABASE=ids_platform
CORS_ALLOWED_ORIGINS=https://sentinel.puk3p.online

# --- provided from Vault at deploy (do NOT set real values here) ---
# MONGODB_URI=

# Alerts auto-expire from MongoDB after this many seconds (TTL index, applied by
# migration 002). Mongo is the hot rolling store; S3 keeps the durable archive.
ALERTS_TTL_SECONDS=3600
