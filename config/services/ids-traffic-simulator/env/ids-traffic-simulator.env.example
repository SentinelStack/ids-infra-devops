# Demo telemetry generator config. Talks to the local backend.
BACKEND_URL=http://localhost:8082

# Edge API key the backend requires on ingest endpoints (same default as the
# agent/backend). Override to match AGENT_API_KEY if you rotate it.
AGENT_API_KEY=edge-agent-7f3c1a9e5b2d4f80

# Device the simulated telemetry is attributed to.
DEVICE_ID=edge-router-01
DEVICE_NAME=Edge Router 01
DEVICE_IP=192.168.1.1

# Cadence for traffic-stat windows + packets, and how many packets per tick.
TICK_SECONDS=20
PACKETS_PER_TICK=4

# One alert every N seconds (72s ~= 50 alerts/hour) and heartbeat cadence.
ALERT_INTERVAL_SECONDS=72
HEARTBEAT_EVERY_TICKS=3
