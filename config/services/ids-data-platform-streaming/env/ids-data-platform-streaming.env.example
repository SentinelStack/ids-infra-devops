# Non-secret config for the data-platform streaming (Flink) service.
# All connections are local to the VPS. No secrets (Kafka is local).

KAFKA_BOOTSTRAP=localhost:9092
ALERTS_TOPIC=ids.alerts
ANOMALIES_TOPIC=traffic-anomalies

# Tumbling window length and the alert count within a window (per source IP)
# above which the source is escalated into a correlated anomaly.
WINDOW_SECONDS=60
ALERT_THRESHOLD=3
