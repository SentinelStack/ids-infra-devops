# Non-secret config for the data-platform processing (Spark) service.
# AWS credentials are NOT here — rendered from Vault (see ../vault.manifest.yml).

SPARK_MASTER=local[2]
KAFKA_BOOTSTRAP=localhost:9092
ALERTS_TOPIC=ids.alerts

S3_OUTPUT=s3a://sentinel-ids-lake/alerts
S3_CHECKPOINT=s3a://sentinel-ids-lake/_checkpoints/alerts
AWS_REGION=eu-north-1
