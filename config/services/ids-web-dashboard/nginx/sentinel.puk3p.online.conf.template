server {
    listen 80;
    server_name sentinel.puk3p.online;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name sentinel.puk3p.online;

    ssl_certificate /etc/letsencrypt/live/sentinel.puk3p.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sentinel.puk3p.online/privkey.pem;

    root /var/www/sentinel.puk3p.online;
    index index.html;

    access_log /var/log/nginx/sentinel.access.log;
    error_log /var/log/nginx/sentinel.error.log;

    # index.html must not be cached so new deploys are picked up immediately.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files $uri =404;
    }

    # Content-hashed assets (Angular outputHashing=all) are immutable.
    location ~* \.(?:js|css|woff2?|ttf|eot|png|jpe?g|gif|svg|ico|webp)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Server-side IP geolocation proxy. ipwho.is rejects browser requests that
    # carry an Origin/Referer (free-tier anti-abuse), so the SPA calls this
    # same-origin path and nginx forwards to ipwho.is without those headers.
    location /geo/ {
        proxy_pass https://ipwho.is/;
        proxy_ssl_server_name on;
        proxy_set_header Host ipwho.is;
        proxy_set_header Origin "";
        proxy_set_header Referer "";
        proxy_set_header Sec-Fetch-Mode "";
        proxy_set_header Sec-Fetch-Site "";
        proxy_set_header Sec-Fetch-Dest "";
        proxy_set_header Sec-Fetch-User "";
        proxy_set_header User-Agent "sentinel-ids-geo";
        add_header Cache-Control "public, max-age=86400";
    }

    # SPA: every unknown path falls back to the Angular entry point.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
