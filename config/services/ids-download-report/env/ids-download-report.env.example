# Non-secret environment defaults for ids-download-report.
# Secrets (CLICKHOUSE_PASSWORD) are NOT listed here — they are rendered from
# Vault at deploy time by scripts/render-env-from-vault.sh (see ../vault.manifest.yml).

ENVIRONMENT=qa
SERVER_PORT=8085

# ClickHouse connection. The app uses the SELECT-only `report_app` user; its
# password is rendered from Vault. compress=0 skips LZ4 (lib not bundled; the
# connection is localhost so it's free).
CLICKHOUSE_URL=jdbc:clickhouse://localhost:8123/sentinel?compress=0
CLICKHOUSE_USER=report_app
CLICKHOUSE_DATABASE=sentinel
CLICKHOUSE_ALERTS_TABLE=alerts

CORS_ALLOWED_ORIGINS=https://sentinel.puk3p.online,http://localhost:4200

# Export guardrails
DOWNLOAD_MAX_ROWS=200000
DOWNLOAD_DEFAULT_ROWS=50000
DOWNLOAD_PREVIEW_ROWS=100

# --- provided from Vault at deploy (do NOT set real values here) ---
# CLICKHOUSE_PASSWORD=
